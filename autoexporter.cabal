cabal-version: 2.2
name: autoexporter
version: 2.0.0.17
synopsis: Automatically re-export modules.
description: Autoexporter automatically re-exports modules.
build-type: Simple
category: Utility
extra-doc-files:
  CHANGELOG.md
  README.md

license-file: LICENSE.txt
license: MIT
maintainer: Taylor Fausak

source-repository head
  location: https://github.com/tfausak/autoexporter
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>=4.20.0.0 || ^>=4.21.0.0 || ^>=4.22.0.0
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-exported-signatures
    -Wno-missing-kind-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  build-depends: autoexporter
  ghc-options:
    -rtsopts
    -threaded

common test-suite
  import: library
  build-tool-depends: autoexporter:autoexporter
  build-depends:
    tasty ^>=1.5.4,
    tasty-hunit ^>=0.10.2,

  other-modules:
    TestTree
    TestTree.DeepLeaves.DeepLeaf1
    TestTree.DeepLeaves.DeepLeaf2
    TestTree.ShallowLeaf

  ghc-options: -Wno-missing-import-lists

library
  import: library
  build-depends:
    Cabal-syntax ^>=3.12.0.0 || ^>=3.14.0.0 || ^>=3.16.0.0,
    directory ^>=1.3.8.1,
    filepath ^>=1.4.100.1 || ^>=1.5.2.0,

  -- cabal-gild: discover source/library
  exposed-modules: Autoexporter
  hs-source-dirs: source/library

executable autoexporter
  import: executable
  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite autoexporter-shallow-test-suite
  import: test-suite
  main-is: Main.hs
  type: exitcode-stdio-1.0
  hs-source-dirs: source/test-suites/shallow

test-suite autoexporter-deep-test-suite
  import: test-suite
  main-is: Main.hs
  type: exitcode-stdio-1.0
  hs-source-dirs: source/test-suites/deep
